  "capabilities": {
    "ATH-C-02": {
      "capability": "federated and cross-account data catalogs",
      "match": [
        "*DataCatalog*"
      ],
      "deny": [
        "CreateDataCatalog",
        "UpdateDataCatalog"
      ],
      "allow": {
        "DeleteDataCatalog": "removes a catalog, which only shrinks the exposure",
        "GetDataCatalog": "read-only",
        "ListDataCatalogs": "read-only"
      }
    },
    "ATH-C-03": {
      "capability": "Spark notebooks, sessions and calculations",
      "match": [
        "*Notebook*",
        "*Session*",
        "*Calculation*",
        "*Executor*",
        "*DPU*"
      ],
      "deny": [
        "CreateNotebook",
        "CreatePresignedNotebookUrl",
        "ExportNotebook",
        "GetSessionEndpoint",
        "ImportNotebook",
        "StartCalculationExecution",
        "StartSession",
        "UpdateNotebook",
        "UpdateNotebookMetadata"
      ],
      "allow": {
        "DeleteNotebook": "removes a notebook, which only shrinks the exposure",
        "GetCalculationExecution": "read-only",
        "GetCalculationExecutionCode": "read-only; no calculation can run, so there is nothing new to read",
        "GetCalculationExecutionStatus": "read-only",
        "GetNotebookMetadata": "read-only",
        "GetSession": "read-only",
        "GetSessionStatus": "read-only",
        "ListApplicationDPUSizes": "read-only, lists sizes, touches no data",
        "ListCalculationExecutions": "read-only",
        "ListExecutors": "read-only",
        "ListNotebookMetadata": "read-only",
        "ListNotebookSessions": "read-only",
        "ListSessions": "read-only",
        "StopCalculationExecution": "stops a calculation, which only shrinks the exposure",
        "TerminateSession": "ends a session, which only shrinks the exposure"
      }
    }
  }
