        "rcp": {
          "status": "planned"
        },
        "scp": {
          "reason": "no action-level deny: the caller is outside the organization",
          "status": "not_applicable"
        },
        "sentinel": {
          "reason": "not visible in a Terraform plan",
          "status": "not_expressible"
        },
        "vpce": {
          "reason": "not a network-path control",
          "status": "not_applicable"
        }
