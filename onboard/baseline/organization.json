      "guardrail": {
        "actions": [
          "sts:AssumeRole",
          "sqs:*",
          "secretsmanager:*"
        ],
        "break_glass_exempt": false,
        "conditions": {
          "BoolIfExists": {
            "aws:PrincipalIsAWSService": "false"
          },
          "StringNotEqualsIfExists": {
            "aws:PrincipalAccount": "${trusted_principal_accounts}",
            "aws:PrincipalOrgID": "${org_id}"
          }
        },
        "optional_parameters": [
          "trusted_principal_accounts"
        ],
        "type": "rcp"
      },
      "implementations": {
        "boundary": {
          "reason": "an organization-wide guardrail, not a delegated-role control",
          "status": "not_applicable"
        },
        "cloudtrail": {
          "detects": "denied calls from principals outside the organization",
          "match": {
            "errorCode": [
              {
                "prefix": "AccessDenied"
              }
            ],
            "eventSource": [
              "sts.amazonaws.com",
              "sqs.amazonaws.com",
              "secretsmanager.amazonaws.com"
            ],
            "userIdentity": {
              "type": [
                "AWSAccount"
              ]
            }
